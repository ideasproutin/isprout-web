{
	"name": "isprout-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:ssr": "npx kill-port 5173 & node server",
		"lint": "eslint .",
		"preview": "vite preview",
		"generate-sitemap": "node scripts/generate-sitemap.js",
		"generate-routes": "node scripts/generate-routes.js",
		"build:base": "npm run generate-sitemap && npm run generate-routes && tsc -b && vite build && vite build --ssr src/entry-server.jsx --outDir dist/server",
		"build": "npm run build:base && node scripts/prerender.js",
		"build:ssr": "npm run build:base",
		"prerender": "node scripts/prerender.js",
		"serve": "NODE_ENV=production node server"
	},
	"dependencies": {
		"@react-google-maps/api": "^2.20.8",
		"@tanstack/react-query": "^5.90.20",
		"@vis.gl/react-google-maps": "^1.7.1",
		"axios": "^1.13.4",
		"express": "^5.2.1",
		"framer-motion": "^12.24.12",
		"google-map-react": "^2.2.5",
		"leaflet": "^1.9.4",
		"lucide-react": "^0.562.0",
		"razorpay": "^2.9.6",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-google-recaptcha": "^3.1.0",
		"react-horizontal-scrolling-menu": "^8.2.0",
		"react-hot-toast": "^2.6.0",
		"react-icons": "^5.5.0",
		"react-leaflet": "^5.0.0",
		"react-loading-skeleton": "^3.5.0",
		"react-router": "^7.9.6",
		"react-router-dom": "^7.9.6",
		"react-youtube": "^10.1.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@types/react-google-recaptcha": "^2.1.9",
		"@vitejs/plugin-react": "^5.1.1",
		"autoprefixer": "^10.4.24",
		"babel-plugin-react-compiler": "^1.0.0",
		"baseline-browser-mapping": "^2.9.19",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"postcss": "^8.5.6",
		"tailwindcss": "^3.4.19",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^7.2.4"
	}
}
